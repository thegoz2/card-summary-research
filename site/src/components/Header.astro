---
import { url, relPath } from '../lib/url';
const path = relPath(Astro.url.pathname);
const isActive = (p: string) =>
  p === '/' ? path === '/' : path.startsWith(p);
---

<header class="sticky top-0 z-30 border-b border-[var(--border)] bg-white/85 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-3 px-4">
    <a href={url('/')} class="flex items-center gap-2 font-extrabold tracking-tight">
      <span class="text-xl">🃏</span>
      <span class="hidden sm:inline">Card Research</span>
    </a>
    <nav class="ml-auto flex items-center gap-1 text-sm">
      <a
        href={url('/')}
        class:list={[
          'rounded-lg px-3 py-1.5 font-medium transition',
          isActive('/') ? 'bg-[var(--accent)] text-white' : 'text-slate-600 hover:bg-slate-100',
        ]}>หน้าแรก</a>
      <a
        href={url('/dashboard/')}
        class:list={[
          'rounded-lg px-3 py-1.5 font-medium transition',
          isActive('/dashboard') ? 'bg-[var(--accent)] text-white' : 'text-slate-600 hover:bg-slate-100',
        ]}>📊 Dashboard</a>
      <a
        href={url('/notes/')}
        class:list={[
          'rounded-lg px-3 py-1.5 font-medium transition',
          path === '/notes/' ? 'bg-[var(--accent)] text-white' : 'text-slate-600 hover:bg-slate-100',
        ]}>โน้ตทั้งหมด</a>
    </nav>
  </div>
</header>
