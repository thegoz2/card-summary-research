---
import Base from '../layouts/Base.astro';
import { CHARS } from '../data/popular';

const chars = [...CHARS].sort((a, b) => b.pop - a.pop);
const count = (p: string) => CHARS.filter((c) => c.project === p).length;
const PROJ = {
  optcg: { label: 'One Piece', icon: '🏴‍☠️', color: '#dc2626' },
  lorcana: { label: 'Disney Lorcana', icon: '🏰', color: '#a855f7' },
} as const;
---

<Base title="ความนิยมตัวละคร">
  <main class="mx-auto max-w-6xl px-4 pb-16">
    <section class="py-8">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">⭐ ความนิยมตัวละคร</h1>
      <p class="mt-3 max-w-2xl text-slate-600">
        ตัวละครไหน "ดัง" — ตัวทำนายว่าการ์ดตัวไหนถือมูลค่า ทั้ง 🏴‍☠️ One Piece และ 🏰 Disney
        <span class="text-sm text-slate-400">· Disney = ตัวเลข merch/franchise จริง · One Piece = เชิงคุณภาพ</span>
      </p>
    </section>

    <!-- Controls -->
    <section class="sticky top-14 z-20 -mx-4 mb-6 border-y border-[var(--border)] bg-[var(--bg)]/90 px-4 py-3 backdrop-blur">
      <input
        id="search"
        type="search"
        placeholder="🔍 ค้นหาตัวละคร… (ชื่อ, ประเภท เช่น เจ้าหญิง/วายร้าย/Pixar)"
        class="w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm outline-none focus:border-[var(--accent)]"
        autocomplete="off"
      />
      <div id="proj-filter" class="mt-3 flex flex-wrap gap-2">
        <button class="chip chip-active" data-proj="all">ทั้งหมด ({CHARS.length})</button>
        <button class="chip" data-proj="optcg">🏴‍☠️ One Piece ({count('optcg')})</button>
        <button class="chip" data-proj="lorcana">🏰 Disney ({count('lorcana')})</button>
      </div>
    </section>

    <div id="grid" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {chars.map((c, i) => {
        const p = PROJ[c.project];
        return (
          <div
            class="pop-card card flex flex-col p-4"
            data-project={c.project}
            data-search={`${c.name} ${c.badge} ${c.note} ${c.momentum ?? ''}`.toLowerCase()}
            style={`border-left:3px solid ${p.color}`}
          >
            <div class="mb-1 flex items-center justify-between gap-2">
              <span class="chip" style={`color:${p.color};border-color:${p.color}`}>{p.icon} {p.label}</span>
              <span class="chip">{c.badge}</span>
            </div>
            <h3 class="text-lg font-bold leading-snug text-slate-100">{c.name}</h3>
            {c.metric && <div class="mt-1 text-sm font-semibold text-[var(--accent-2)]">{c.metric}</div>}
            {c.momentum && <div class="mt-0.5 text-xs text-slate-300">{c.momentum}</div>}
            {c.note && <div class="mt-2 text-xs text-slate-400">{c.note}</div>}
            <div class="mt-auto pt-2 text-xs text-slate-500">{c.conf}</div>
          </div>
        );
      })}
    </div>

    <p id="no-results" class="hidden py-10 text-center text-slate-400">ไม่พบตัวละครที่ตรงกับคำค้น</p>

    <p class="mt-6 text-xs text-slate-400">
      ⚠️ One Piece: ลำดับเป๊ะของตัวละครยังไม่ยืนยัน (ตัวหลักดันราคา ~2–4× ตัวรอง) · Disney: "merch รายปี" = ดีมานด์ปัจจุบัน,
      "franchise" = รายได้สะสมหลายสิบปี (เฟ้อ ไม่ใช่ความฮอตตอนนี้) · Star Wars/Marvel ไม่อยู่ใน Lorcana
    </p>
  </main>

  <script is:inline>
    const search = document.getElementById('search');
    const cards = Array.from(document.querySelectorAll('.pop-card'));
    const chips = Array.from(document.querySelectorAll('#proj-filter button'));
    const noResults = document.getElementById('no-results');
    let activeProj = 'all';
    function apply() {
      const q = (search.value || '').trim().toLowerCase();
      let visible = 0;
      for (const card of cards) {
        const projOk = activeProj === 'all' || activeProj === card.dataset.project;
        const match = projOk && (!q || card.dataset.search.includes(q));
        card.style.display = match ? '' : 'none';
        if (match) visible++;
      }
      noResults.classList.toggle('hidden', visible > 0);
    }
    search.addEventListener('input', apply);
    chips.forEach((chip) => chip.addEventListener('click', () => {
      activeProj = chip.dataset.proj;
      chips.forEach((c) => c.classList.toggle('chip-active', c === chip));
      apply();
    }));
  </script>
</Base>
