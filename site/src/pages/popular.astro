---
import Base from '../layouts/Base.astro';
import { CHARS } from '../data/popular';

const PROJ = {
  optcg: { key: 'optcg', label: 'One Piece', icon: '🏴‍☠️', color: '#ef4444' },
  lorcana: { key: 'lorcana', label: 'Disney Lorcana', icon: '🏰', color: '#c084fc' },
} as const;

type Key = keyof typeof PROJ;
const ORDER: Key[] = ['optcg', 'lorcana'];

const groups = ORDER.map((k) => ({
  ...PROJ[k],
  chars: CHARS.filter((c) => c.project === k).sort((a, b) => b.pop - a.pop),
}));
const count = (p: Key) => CHARS.filter((c) => c.project === p).length;
const medal = (i: number) => (i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : '');
---

<Base title="ความนิยมตัวละคร">
  <main class="mx-auto max-w-5xl px-4 pb-16">
    <section class="py-8">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">⭐ ความนิยมตัวละคร</h1>
      <p class="mt-3 max-w-2xl text-slate-600">
        ตัวละครไหน "ดัง" — ตัวทำนายว่าการ์ดตัวไหนถือมูลค่า จัดอันดับแยก 🏴‍☠️ One Piece และ 🏰 Disney
      </p>
      <!-- legend -->
      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-slate-400">
        <span class="flex items-center gap-1.5"><span class="legend-bar"></span> แถบ = คะแนนความนิยม</span>
        <span>🥇🥈🥉 = อันดับสูงสุด</span>
        <span><span class="legend-mom">ข่าว/ปัจจัยหนุน</span></span>
        <span>✅ ยืนยัน · ⚠️ ยังไม่ชัด</span>
      </div>
    </section>

    <!-- Controls -->
    <section class="sticky top-14 z-20 -mx-4 mb-6 border-y border-[var(--border)] bg-[var(--bg)]/90 px-4 py-3 backdrop-blur">
      <input
        id="search"
        type="search"
        placeholder="🔍 ค้นหาตัวละคร… (ชื่อ, ประเภท เช่น เจ้าหญิง/วายร้าย/Pixar)"
        class="w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm outline-none focus:border-[var(--accent)]"
        autocomplete="off"
      />
      <div id="proj-filter" class="mt-3 flex flex-wrap gap-2">
        <button class="chip chip-active" data-proj="all">ทั้งหมด ({CHARS.length})</button>
        <button class="chip" data-proj="optcg">🏴‍☠️ One Piece ({count('optcg')})</button>
        <button class="chip" data-proj="lorcana">🏰 Disney ({count('lorcana')})</button>
      </div>
    </section>

    {groups.map((g) => (
      <section class="pop-section mb-10" data-proj={g.key}>
        <h2 class="mb-3 flex items-center gap-2 text-xl font-extrabold" style={`color:${g.color}`}>
          <span>{g.icon}</span>{g.label}
          <span class="text-sm font-normal text-slate-400">({g.chars.length} ตัว)</span>
        </h2>
        <div class="plist card" style={`--c:${g.color}`}>
          {g.chars.map((c, i) => (
            <div
              class="prow"
              data-project={c.project}
              data-search={`${c.name} ${c.badge} ${c.note} ${c.momentum ?? ''}`.toLowerCase()}
            >
              <span class:list={['rank', { top: i < 3 }]}>{medal(i) || i + 1}</span>

              <div class="prow-main">
                <div class="prow-head">
                  <span class="prow-name">{c.name}</span>
                  <span class="badge-type">{c.badge}</span>
                  <span class="text-xs" title="ความเชื่อมั่นของข้อมูล">{c.conf}</span>
                </div>
                {(c.momentum || c.note || c.metric) && (
                  <div class="prow-sub">
                    {c.momentum && <span class="mom">{c.momentum}</span>}
                    {c.metric && <span class="metric">{c.metric}</span>}
                    {c.note && <span class="note">{c.note}</span>}
                  </div>
                )}
              </div>

              <div class="prow-pop" title={`ความนิยม ${c.pop}/100`}>
                <span class="popbar"><span style={`width:${c.pop}%;background:${g.color}`}></span></span>
                <span class="popnum">{c.pop}</span>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}

    <p id="no-results" class="hidden py-10 text-center text-slate-400">ไม่พบตัวละครที่ตรงกับคำค้น</p>

    <p class="mt-2 text-xs text-slate-400">
      ⚠️ One Piece: ลำดับเป๊ะของตัวละครยังไม่ยืนยัน (ตัวหลักดันราคา ~2–4× ตัวรอง) · Disney: "merch รายปี" = ดีมานด์ปัจจุบัน,
      "franchise" = รายได้สะสมหลายสิบปี (เฟ้อ ไม่ใช่ความฮอตตอนนี้) · Star Wars/Marvel ไม่อยู่ใน Lorcana
    </p>
  </main>

  <style>
    .legend-bar {
      display: inline-block; width: 1.6rem; height: 7px; border-radius: 9999px;
      background: linear-gradient(90deg, #ef4444, #c084fc);
    }
    .legend-mom {
      font-size: 0.72rem; font-weight: 600; color: var(--accent-2);
      background: color-mix(in srgb, var(--accent-2) 14%, transparent);
      border-radius: 6px; padding: 0.05rem 0.4rem;
    }

    .plist { padding: 0.25rem 0.4rem; }

    .prow {
      display: flex; align-items: center; gap: 0.85rem;
      padding: 0.6rem 0.7rem; border-radius: 10px;
      border-bottom: 1px solid var(--border);
      transition: background 0.12s;
    }
    .prow:last-child { border-bottom: 0; }
    .prow:hover { background: color-mix(in srgb, var(--c) 8%, transparent); }

    .rank {
      display: flex; align-items: center; justify-content: center;
      width: 2rem; height: 2rem; flex: none;
      border-radius: 9999px; font-weight: 800; font-size: 0.85rem;
      border: 1.5px solid var(--c); color: var(--c);
      background: color-mix(in srgb, var(--c) 12%, transparent);
    }
    .rank.top { font-size: 1.1rem; background: transparent; border-color: transparent; }

    .prow-main { flex: 1 1 240px; min-width: 0; }
    .prow-head { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
    .prow-name { font-size: 1rem; font-weight: 800; color: var(--text-strong); }
    .badge-type {
      font-size: 0.7rem; font-weight: 600; padding: 0.06rem 0.5rem; border-radius: 9999px;
      color: var(--c); border: 1px solid color-mix(in srgb, var(--c) 45%, var(--border));
      background: color-mix(in srgb, var(--c) 10%, transparent); white-space: nowrap;
    }
    .prow-sub {
      margin-top: 0.25rem; display: flex; flex-wrap: wrap; align-items: center;
      gap: 0.4rem 0.6rem; font-size: 0.76rem; line-height: 1.4;
    }
    .prow-sub .mom {
      font-weight: 600; color: var(--accent-2);
      background: color-mix(in srgb, var(--accent-2) 13%, transparent);
      border-radius: 6px; padding: 0.1rem 0.45rem;
    }
    .prow-sub .metric { font-weight: 600; color: var(--accent-2); }
    .prow-sub .note { color: var(--faint); }

    .prow-pop { display: flex; align-items: center; gap: 0.55rem; flex: none; width: 170px; }
    .popbar { flex: 1; height: 8px; border-radius: 9999px; background: var(--surface-2); overflow: hidden; }
    .popbar > span { display: block; height: 100%; border-radius: 9999px; }
    .popnum { width: 2.2ch; text-align: right; font-size: 0.8rem; font-weight: 700; color: var(--muted); }

    @media (max-width: 640px) {
      .prow { flex-wrap: wrap; gap: 0.5rem 0.7rem; }
      .prow-pop { width: 100%; padding-left: 2.85rem; }
    }
  </style>

  <script is:inline>
    const search = document.getElementById('search');
    const sections = Array.from(document.querySelectorAll('.pop-section'));
    const chips = Array.from(document.querySelectorAll('#proj-filter button'));
    const noResults = document.getElementById('no-results');
    let activeProj = 'all';

    function apply() {
      const q = (search.value || '').trim().toLowerCase();
      let visible = 0;
      for (const section of sections) {
        const projOk = activeProj === 'all' || activeProj === section.dataset.proj;
        let secVisible = 0;
        for (const row of section.querySelectorAll('.prow')) {
          const match = projOk && (!q || row.dataset.search.includes(q));
          row.style.display = match ? '' : 'none';
          if (match) secVisible++;
        }
        section.style.display = secVisible > 0 ? '' : 'none';
        visible += secVisible;
      }
      noResults.classList.toggle('hidden', visible > 0);
    }

    search.addEventListener('input', apply);
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        activeProj = chip.dataset.proj;
        chips.forEach((c) => c.classList.toggle('chip-active', c === chip));
        apply();
      })
    );
  </script>
</Base>
