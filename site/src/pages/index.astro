---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import {
  noteTitle,
  noteSlug,
  noteTags,
  categoryOf,
  projectOf,
  PROJECTS,
  excerpt,
  allCategories,
} from '../lib/notes';
import { url } from '../lib/url';

const notes = await getCollection('notes');

const items = notes
  .map((n) => ({
    slug: noteSlug(n),
    title: noteTitle(n),
    tags: noteTags(n),
    excerpt: excerpt(n.body ?? ''),
    cat: categoryOf(n).key,
    project: projectOf(n).key,
    date: n.data.date ? new Date(n.data.date).toISOString().slice(0, 10) : '',
  }))
  .sort((a, b) => a.title.localeCompare(b.title, 'th'));

const grouped = allCategories()
  .map((c) => ({ ...c, notes: items.filter((i) => i.cat === c.key) }))
  .filter((c) => c.notes.length > 0);

const projCount = (k: string) => items.filter((i) => i.project === k).length;

// overview note link per project (avoid hardcoding Thai slugs)
const overviewLink = (projKey: string) => {
  const n = notes.find((x) => projectOf(x).key === projKey && /ภาพรวม/.test(noteTitle(x)));
  return n ? url(`/notes/${noteSlug(n)}/`) : url('/notes/');
};

const lastUpdated = notes
  .map((n) => (n.data.updated || n.data.date) as Date | undefined)
  .filter(Boolean)
  .map((d) => new Date(d as Date).getTime())
  .sort((a, b) => b - a)[0];
const lastUpdatedStr = lastUpdated ? new Date(lastUpdated).toISOString().slice(0, 10) : '—';
---

<Base>
  <main class="mx-auto max-w-6xl px-4 pb-16">
    <!-- Hero -->
    <section class="py-8">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">
        งานวิจัยการ์ดสะสม — ทำกำไร
      </h1>
      <p class="mt-3 max-w-2xl text-slate-600">
        สรุปงานวิจัยการ์ดสะสมเพื่อทำกำไร <b>{notes.length} บทความ</b> ให้อ่านง่าย —
        ดูราคา แนวโน้ม และความเสี่ยงได้ในที่เดียว
        <span class="text-sm text-slate-400">· อัปเดตล่าสุด {lastUpdatedStr}</span>
      </p>
      <p class="mt-1 text-sm text-slate-400">💡 ในหน้า Dashboard มี "สรุปสั้น" บนสุด และคำศัพท์ยากแตะดูคำแปลได้</p>

      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <!-- One Piece -->
        <div class="card flex flex-col p-5" data-theme="op">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 text-lg font-bold">🏴‍☠️ One Piece TCG</div>
            <span class="chip">{projCount('optcg')} โน้ต</span>
          </div>
          <p class="mt-2 text-sm text-slate-500">เก็งกำไร sealed/PSA · ตลาด JP/EN · มี Dashboard เต็ม</p>
          <div class="mt-4 flex flex-wrap gap-2">
            <a href={url('/dashboard/')} class="rounded-lg bg-[var(--accent)] px-4 py-2 text-sm font-semibold text-white transition hover:opacity-90">📊 Dashboard</a>
            <a href={overviewLink('optcg')} class="rounded-lg border border-[var(--border)] bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">📖 ภาพรวม</a>
          </div>
        </div>
        <!-- Lorcana -->
        <div class="card flex flex-col p-5" data-theme="lorcana">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 text-lg font-bold">🏰 Disney Lorcana</div>
            <span class="chip">{projCount('lorcana')} โน้ต</span>
          </div>
          <p class="mt-2 text-sm text-slate-500">IP Disney/Pixar · สะสมระยะยาว · anti-scarcity (ไม่มี Reserved List) · มี Dashboard เต็ม</p>
          <div class="mt-4 flex flex-wrap gap-2">
            <a href={url('/dashboard/lorcana/')} class="rounded-lg bg-[var(--accent)] px-4 py-2 text-sm font-semibold text-white transition hover:opacity-90">📊 Dashboard</a>
            <a href={overviewLink('lorcana')} class="rounded-lg border border-[var(--border)] bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">📖 ภาพรวม</a>
            <button data-jump="lorcana" class="rounded-lg border border-[var(--border)] bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">🔎 โน้ต</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Controls -->
    <section class="sticky top-14 z-20 -mx-4 mb-6 border-y border-[var(--border)] bg-[var(--bg)]/90 px-4 py-3 backdrop-blur">
      <input
        id="search"
        type="search"
        placeholder="🔍 ค้นหาโน้ต… (พิมพ์ชื่อ หัวข้อ หรือแท็ก)"
        class="w-full rounded-xl border border-[var(--border)] bg-white px-4 py-2.5 text-sm outline-none focus:border-[var(--accent)]"
        autocomplete="off"
      />
      <div id="proj-filter" class="mt-3 flex flex-wrap gap-2">
        <button class="chip chip-active" data-proj="all">ทุกโปรเจกต์ ({notes.length})</button>
        {PROJECTS.map((p) => (
          <button class="chip" data-proj={p.key}>{p.icon} {p.label} ({projCount(p.key)})</button>
        ))}
      </div>
      <div id="cat-filter" class="mt-2 flex flex-wrap gap-2">
        <button class="chip chip-active" data-cat="all">ทุกหมวด</button>
        {grouped.map((c) => (
          <button class="chip" data-cat={c.key}>{c.icon} {c.label}</button>
        ))}
      </div>
    </section>

    <!-- Note groups -->
    <div id="groups">
      {grouped.map((c) => (
        <section class="note-group mb-8" data-cat={c.key}>
          <h2 class="mb-3 flex items-center gap-2 text-lg font-bold">
            <span>{c.icon}</span>{c.label}
            <span class="text-sm font-normal text-slate-400">({c.notes.length})</span>
          </h2>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {c.notes.map((n) => (
              <a
                href={url(`/notes/${n.slug}/`)}
                class="note-card card group flex flex-col p-4 transition hover:border-[var(--accent)] hover:shadow-sm"
                data-project={n.project}
                data-title={n.title.toLowerCase()}
                data-tags={n.tags.join(' ').toLowerCase()}
                data-text={n.excerpt.toLowerCase()}
              >
                <h3 class="font-semibold leading-snug text-slate-800 group-hover:text-[var(--accent)]">
                  {n.title}
                </h3>
                {n.excerpt && (
                  <p class="mt-1.5 line-clamp-3 text-sm text-slate-500">{n.excerpt}</p>
                )}
                {n.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-1">
                    {n.tags.slice(0, 4).map((t) => <span class="chip">{t}</span>)}
                  </div>
                )}
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>

    <p id="no-results" class="hidden py-10 text-center text-slate-400">ไม่พบโน้ตที่ตรงกับคำค้น</p>
  </main>

  <script is:inline>
    const search = document.getElementById('search');
    const groups = Array.from(document.querySelectorAll('.note-group'));
    const catChips = Array.from(document.querySelectorAll('#cat-filter button'));
    const projChips = Array.from(document.querySelectorAll('#proj-filter button'));
    const noResults = document.getElementById('no-results');
    let activeCat = 'all';
    let activeProj = 'all';

    function apply() {
      const q = (search.value || '').trim().toLowerCase();
      let visibleTotal = 0;
      for (const group of groups) {
        const catOk = activeCat === 'all' || activeCat === group.dataset.cat;
        let groupVisible = 0;
        for (const card of group.querySelectorAll('.note-card')) {
          const hay = card.dataset.title + ' ' + card.dataset.tags + ' ' + card.dataset.text;
          const projOk = activeProj === 'all' || activeProj === card.dataset.project;
          const match = catOk && projOk && (!q || hay.includes(q));
          card.style.display = match ? '' : 'none';
          if (match) groupVisible++;
        }
        group.style.display = groupVisible > 0 ? '' : 'none';
        visibleTotal += groupVisible;
      }
      noResults.classList.toggle('hidden', visibleTotal > 0);
    }

    function setProj(key) {
      activeProj = key;
      projChips.forEach((c) => c.classList.toggle('chip-active', c.dataset.proj === key));
      apply();
    }

    search.addEventListener('input', apply);
    catChips.forEach((chip) => chip.addEventListener('click', () => {
      activeCat = chip.dataset.cat;
      catChips.forEach((c) => c.classList.toggle('chip-active', c === chip));
      apply();
    }));
    projChips.forEach((chip) => chip.addEventListener('click', () => setProj(chip.dataset.proj)));

    document.querySelectorAll('[data-jump]').forEach((btn) =>
      btn.addEventListener('click', () => {
        setProj(btn.dataset.jump);
        document.getElementById('groups')?.scrollIntoView({ behavior: 'smooth' });
      })
    );
  </script>
</Base>
