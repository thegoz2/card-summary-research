---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { rawName, noteSlug } from '../lib/notes';
import { parseLogTable } from '../lib/tracking';
import * as M from '../data/market';

const all = await getCollection('notes');
const trackingNote = all.find((n) => rawName(n).includes('Tracking Sheet'));
const series = trackingNote ? parseLogTable(trackingNote.body ?? '') : [];
const noteLink = (titlePart: string) => {
  const n = all.find((x) => rawName(x).includes(titlePart));
  return n ? `/notes/${noteSlug(n)}/` : '/notes/';
};
const fmt = (n: number) => n.toLocaleString('en-US');

// KPIs
const op13 = M.BOX_PRICES.find((b) => b.set === 'OP-13')!;
const usSasomRatio = (op13.usSec! / op13.sasom!).toFixed(1);
const sealed = M.TCGKING.find((t) => t.key === 'Sealed Box')!.value;
const tr = M.TCGKING.find((t) => t.key === 'Treasure Rare')!.value;
const dot = (s: string) => (s === 'green' ? '🟢' : s === 'yellow' ? '🟡' : '🔴');
const greenCount = M.BUBBLE.filter((b) => b.status === 'green').length;
const yellowCount = M.BUBBLE.filter((b) => b.status === 'yellow').length;
const redCount = M.BUBBLE.filter((b) => b.status === 'red').length;

const SECTIONS = [
  { id: 'pulse', label: '📍 ภาพรวม' },
  { id: 'risk', label: '🚦 ดัชนี & สัญญาณ' },
  { id: 'price', label: '💰 ราคา' },
  { id: 'grade', label: '🏆 เกรด & การ์ด' },
  { id: 'cost', label: '🚚 ต้นทุน' },
  { id: 'strategy', label: '🎯 Pull Rate & กลยุทธ์' },
  { id: 'invest', label: '📊 ลงทุน' },
  { id: 'forecast', label: '🔮 พยากรณ์' },
];

const green = '#16a34a', red = '#dc2626', amber = '#f59e0b', blue = '#3b82f6';
const base = { responsive: true, maintainAspectRatio: false };
const noLegend = { legend: { display: false } };

const charts: Record<string, unknown> = {
  tcgking: {
    type: 'bar',
    data: { labels: M.TCGKING.map((d) => d.key), datasets: [{ data: M.TCGKING.map((d) => d.ytd), backgroundColor: M.TCGKING.map((d) => (d.ytd >= 0 ? green : red)), borderRadius: 6 }] },
    options: { ...base, indexAxis: 'y', plugins: noLegend, scales: { x: { title: { display: true, text: 'YTD %' } } } },
  },
  box: {
    type: 'bar',
    data: { labels: M.BOX_PRICES.map((b) => b.set), datasets: M.BOX_MARKETS.map((m) => ({ label: m.label, data: M.BOX_PRICES.map((b) => (b as Record<string, number | null>)[m.key]), backgroundColor: m.color, borderRadius: 5 })) },
    options: { ...base, plugins: { legend: { position: 'bottom' } }, scales: { y: { title: { display: true, text: 'บาท' } } } },
  },
  carry: {
    type: 'bar',
    data: {
      labels: M.CARRY.map((c) => c.country),
      datasets: [
        { type: 'line', label: 'SASOM 4,300', data: M.CARRY.map(() => M.CARRY_REF.sasom), borderColor: red, borderDash: [5, 4], pointRadius: 0, borderWidth: 1.5 },
        { type: 'line', label: 'รีเทล 7,500', data: M.CARRY.map(() => M.CARRY_REF.retail), borderColor: amber, borderDash: [5, 4], pointRadius: 0, borderWidth: 1.5 },
        { type: 'bar', label: 'ราคาหิ้ว/กล่อง', data: M.CARRY.map((c) => c.baht), backgroundColor: blue, borderRadius: 5 },
      ],
    },
    options: { ...base, plugins: { legend: { position: 'bottom' } }, scales: { y: { title: { display: true, text: 'บาท' } } } },
  },
  op17: {
    type: 'bar',
    data: { labels: M.OP17.prices.map((p) => p.src), datasets: [{ data: M.OP17.prices.map((p) => p.baht), backgroundColor: M.OP17.prices.map((p) => (p.baht <= 5000 ? green : p.baht <= 7000 ? amber : red)), borderRadius: 5 }] },
    options: { ...base, indexAxis: 'y', plugins: noLegend, scales: { x: { title: { display: true, text: 'บาท/กล่อง · เขียว=สมเหตุผล' } } } },
  },
  singles: {
    type: 'bar',
    data: { labels: M.SINGLES.map((s) => s.card), datasets: [{ label: 'RAW', data: M.SINGLES.map((s) => s.raw), backgroundColor: '#94a3b8', borderRadius: 5 }, { label: 'GRADED', data: M.SINGLES.map((s) => s.graded), backgroundColor: amber, borderRadius: 5 }] },
    options: { ...base, indexAxis: 'y', plugins: { legend: { position: 'bottom' } }, scales: { x: { type: 'logarithmic', title: { display: true, text: 'บาท (log)' } } } },
  },
  grading: {
    type: 'bar',
    data: { labels: M.GRADING.map((g) => g.tier), datasets: [{ data: M.GRADING.map((g) => g.usd), backgroundColor: M.GRADING.map((g) => (g.co === 'PSA' ? red : blue)), borderRadius: 5 }] },
    options: { ...base, indexAxis: 'y', plugins: noLegend, scales: { x: { title: { display: true, text: 'USD/ใบ · แดง=PSA น้ำเงิน=CGC' } } } },
  },
  cardkub: {
    type: 'bar',
    data: { labels: M.CARDKUB.map((c) => c.tier), datasets: [{ data: M.CARDKUB.map((c) => c.baht), backgroundColor: '#8b5cf6', borderRadius: 5 }] },
    options: { ...base, plugins: noLegend, scales: { y: { title: { display: true, text: 'บาท/ใบ (รวมส่งไป-กลับ)' } } } },
  },
  dhl: {
    type: 'line',
    data: { labels: M.DHL.weights, datasets: M.DHL.routes.map((r) => ({ label: r.label, data: r.baht, borderColor: r.color, backgroundColor: r.color, tension: 0.2 })) },
    options: { ...base, plugins: { legend: { position: 'bottom' } }, scales: { y: { title: { display: true, text: 'บาท' } } } },
  },
  fees: {
    type: 'bar',
    data: { labels: M.FEES.map((f) => f.platform), datasets: [{ data: M.FEES.map((f) => f.pct), backgroundColor: M.FEES.map((f) => (f.scope === 'ในประเทศ' ? blue : amber)), borderRadius: 5 }] },
    options: { ...base, indexAxis: 'y', plugins: noLegend, scales: { x: { title: { display: true, text: '% all-in · น้ำเงิน=ในประเทศ ส้ม=ส่งออก' } } } },
  },
  landed: {
    type: 'bar',
    data: { labels: M.LANDED.map((l) => l.scenario), datasets: [{ data: M.LANDED.map((l) => l.margin), backgroundColor: M.LANDED.map((l) => (l.margin >= 0 ? green : red)), borderRadius: 5 }] },
    options: { ...base, indexAxis: 'y', plugins: noLegend, scales: { x: { title: { display: true, text: 'มาร์จิ้น % (นำเข้ามาขายในไทย)' } } } },
  },
  pull: {
    type: 'bar',
    data: { labels: M.PULL.map((p) => p.rarity), datasets: [{ data: M.PULL.map((p) => p.oneIn), backgroundColor: ['#94a3b8', blue, '#8b5cf6', amber, red], borderRadius: 5 }] },
    options: { ...base, plugins: noLegend, scales: { y: { type: 'logarithmic', title: { display: true, text: '1 ใน N ซอง (log)' } } } },
  },
  forecast: {
    type: 'bar',
    data: { labels: M.FORECAST.map((f) => f.period), datasets: [{ data: M.FORECAST.map((f) => f.range), backgroundColor: '#ef4444', borderRadius: 5 }] },
    options: { ...base, indexAxis: 'y', plugins: noLegend, scales: { x: { title: { display: true, text: 'ช่วงคาดการณ์ %' } } } },
  },
  spec: {
    type: 'bar',
    data: { labels: M.SPEC_TYPES.map((s) => s.type), datasets: [{ data: M.SPEC_TYPES.map((s) => s.range), backgroundColor: [red, amber], borderRadius: 5 }] },
    options: { ...base, indexAxis: 'y', plugins: noLegend, scales: { x: { title: { display: true, text: 'ช่วงผลตอบแทน %' } } } },
  },
  op13run: {
    type: 'line',
    data: { labels: M.OP13_RUN.map((p) => p.t), datasets: [{ label: 'OP-13 box (USD)', data: M.OP13_RUN.map((p) => p.usd), borderColor: red, backgroundColor: red, tension: 0.3, fill: false }] },
    options: { ...base, plugins: noLegend, scales: { y: { title: { display: true, text: 'USD/กล่อง' } } } },
  },
  buckets: {
    type: 'doughnut',
    data: { labels: M.BUCKETS.map((b) => b.name), datasets: [{ data: M.BUCKETS.map((b) => b.pct), backgroundColor: M.BUCKETS.map((b) => b.color) }] },
    options: { ...base, plugins: { legend: { position: 'bottom' } } },
  },
};
if (series.length > 0) {
  charts.series = {
    type: 'line',
    data: { labels: series.map((r) => r.month), datasets: [
      { label: 'Sealed', data: series.map((r) => r.sealed), borderColor: blue, backgroundColor: blue, tension: 0.3, spanGaps: true },
      { label: 'Leader Alt', data: series.map((r) => r.leader), borderColor: green, backgroundColor: green, tension: 0.3, spanGaps: true },
      { label: 'Treasure Rare', data: series.map((r) => r.tr), borderColor: red, backgroundColor: red, tension: 0.3, spanGaps: true },
    ] },
    options: { ...base, plugins: { legend: { position: 'bottom' } } },
  };
}
const chartsJson = JSON.stringify(charts).replaceAll('<', '\\u003c');

const tone = (t: string) => (t === 'green' ? 'border-green-500 bg-green-50' : t === 'yellow' ? 'border-amber-500 bg-amber-50' : 'border-red-500 bg-red-50');
---

<Base title="Dashboard">
  <main class="mx-auto max-w-6xl px-4 py-6">
    <div class="flex flex-wrap items-end justify-between gap-2">
      <div>
        <h1 class="text-2xl font-extrabold sm:text-3xl">📊 Dashboard วิเคราะห์ตลาด OP TCG</h1>
        <p class="mt-1 text-xs text-slate-500">ข้อมูล ณ {M.META.asOf} · {M.META.rates}</p>
      </div>
      <a href={noteLink('Tracking Sheet')} class="text-sm text-[var(--accent)] hover:underline">เปิด Tracking Sheet →</a>
    </div>

    <!-- Section nav -->
    <nav class="sticky top-14 z-20 -mx-4 mt-3 flex gap-2 overflow-x-auto border-y border-[var(--border)] bg-[var(--bg)]/90 px-4 py-2 backdrop-blur">
      {SECTIONS.map((s) => (
        <a href={`#${s.id}`} class="chip shrink-0 hover:bg-slate-200">{s.label}</a>
      ))}
    </nav>

    <!-- ============ PULSE ============ -->
    <section id="pulse" class="scroll-mt-28 pt-6">
      <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
        <div class="card p-4"><div class="text-xs text-slate-500">TCGKing Sealed</div><div class="mt-1 text-2xl font-extrabold signal-green">{sealed}</div><div class="text-xs text-slate-400">+29.4% YTD</div></div>
        <div class="card p-4"><div class="text-xs text-slate-500">Treasure Rare</div><div class="mt-1 text-2xl font-extrabold signal-red">{tr}</div><div class="text-xs text-slate-400">−19.4% YTD</div></div>
        <div class="card p-4"><div class="text-xs text-slate-500">นักเก็งกำไรในตลาด</div><div class="mt-1 text-2xl font-extrabold signal-yellow">~{M.META.speculatorShare}%</div><div class="text-xs text-slate-400">เดิม ~25% เมื่อ 2–3 ปีก่อน</div></div>
        <div class="card p-4"><div class="text-xs text-slate-500">สัญญาณฟองสบู่</div><div class="mt-1 text-2xl font-extrabold">{M.META.bubbleSignals.present}/{M.META.bubbleSignals.total}</div><div class="text-xs text-slate-400">phase: {M.META.phaseNow}</div></div>
      </div>

      <!-- Cycle strip -->
      <div class="card mt-4 flex items-stretch gap-0 overflow-x-auto p-2">
        {M.CYCLE.map((c, i) => (
          <>
            <div class:list={['min-w-[110px] flex-1 rounded-lg px-3 py-2 text-center', c.active ? 'bg-[var(--accent)] text-white' : 'text-slate-500']}>
              <div class="text-sm font-bold">{c.phase}</div>
              <div class="text-xs opacity-80">{c.period}</div>
            </div>
            {i < M.CYCLE.length - 1 && <div class="flex items-center text-slate-300">→</div>}
          </>
        ))}
      </div>
      <p class="mt-2 text-xs text-slate-400">วงจรตลาดอยู่ช่วง Distribution กำลังเข้า "จุดตัดสิน" = OP-17 (ก.ย. 2026) วางขายพร้อมกันทั่วโลกครั้งแรก</p>
    </section>

    <!-- ============ RISK ============ -->
    <section id="risk" class="scroll-mt-28 pt-10">
      <h2 class="mb-4 text-xl font-bold">🚦 ดัชนี & สัญญาณความเสี่ยง</h2>

      <div class="grid gap-5 lg:grid-cols-2">
        <div class="card p-4">
          <h3 class="mb-1 font-bold">ดัชนี TCGKing — YTD %</h3>
          <p class="mb-3 text-xs text-slate-500">⚠️ ดัชนีผู้ขายรายเดียว · เขียว=ขึ้น แดง=ลง (ตลาดแยกขั้ว)</p>
          <div class="h-64"><canvas id="chart-tcgking"></canvas></div>
        </div>
        <div class="card p-4">
          <h3 class="mb-1 font-bold">แนวโน้มดัชนีรายเดือน</h3>
          <p class="mb-3 text-xs text-slate-500">{series.length > 1 ? 'จากตาราง Log ใน Tracking Sheet' : 'มี 1 จุด baseline — กรอกเดือนถัดไปใน Obsidian แล้วเส้นต่อเอง'}</p>
          <div class="h-64"><canvas id="chart-series"></canvas></div>
        </div>
      </div>

      <!-- 8 bubble signals -->
      <div class="card mt-5 mb-4 flex flex-wrap items-center gap-x-6 gap-y-2 p-4">
        <div class="text-sm"><span class="signal-green font-bold">🟢 {greenCount}</span> · <span class="signal-yellow font-bold">🟡 {yellowCount}</span> · <span class="signal-red font-bold">🔴 {redCount}</span></div>
        <div class="text-sm font-semibold text-amber-700">อ่านสัญญาณ: 🟡 Base เริ่มเอียง bearish — ดัชนีรอง SP/TR หลุด 100 (late-cycle)</div>
        <a href={noteLink('ฟองสบู่')} class="ml-auto text-sm text-[var(--accent)] hover:underline">บทวิเคราะห์เต็ม →</a>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {M.BUBBLE.map((b) => (
          <div class="card p-3"><div class="flex items-start gap-2"><span class="text-lg leading-none">{dot(b.status)}</span><div><div class="text-sm font-semibold leading-snug">{b.name}</div><div class="mt-1 text-xs text-slate-500">{b.detail}</div></div></div></div>
        ))}
      </div>

      <!-- 3 scenarios -->
      <h3 class="mt-8 mb-3 font-bold">3 ฉากทัศน์ (Bull / Base / Bear)</h3>
      <div class="grid gap-3 lg:grid-cols-3">
        {M.SCENARIOS.map((s) => (
          <div class:list={['rounded-xl border-l-4 p-4', tone(s.tone)]}>
            <div class="flex items-center justify-between"><div class="font-bold">{s.emoji} {s.name}</div></div>
            <div class="mt-1 text-xs font-semibold text-slate-600">โอกาส: {s.prob}</div>
            <div class="mt-2 text-sm font-medium">{s.outcome}</div>
            <div class="mt-2 text-xs text-slate-600">{s.detail}</div>
            <div class="mt-2 text-xs text-slate-500"><span class="font-semibold">ทริกเกอร์:</span> {s.trigger}</div>
          </div>
        ))}
      </div>
      <p class="mt-2 text-xs text-slate-400">⚠️ ความน่าจะเป็นเป็นการประเมินเชิงคุณภาพ ไม่ใช่ตัวเลขโมเดล</p>
    </section>

    <!-- ============ PRICE ============ -->
    <section id="price" class="scroll-mt-28 pt-10">
      <h2 class="mb-4 text-xl font-bold">💰 ราคา Booster Box</h2>
      <div class="grid gap-5 lg:grid-cols-2">
        <div class="card p-4"><h3 class="mb-1 font-bold">เทียบตลาด TH / JP / US (บาท)</h3><p class="mb-3 text-xs text-slate-500">OP-13 blue-chip ต่างกันถึง {usSasomRatio}× (US vs SASOM)</p><div class="h-72"><canvas id="chart-box"></canvas></div></div>
        <div class="card p-4"><h3 class="mb-1 font-bold">ราคาหิ้ว OP-16 รายประเทศ (บาท)</h3><p class="mb-3 text-xs text-slate-500">landed/กล่อง เทียบเส้น SASOM 4,300 & รีเทล 7,500</p><div class="h-72"><canvas id="chart-carry"></canvas></div></div>
        <div class="card p-4"><h3 class="mb-1 font-bold">ราคาพรี OP-17 รายแหล่ง (บาท)</h3><p class="mb-3 text-xs text-slate-500">สมเหตุผล EN ฿4,300–5,000 · &gt;฿7,500 ตอนกระแส = แพงเกิน</p><div class="h-72"><canvas id="chart-op17"></canvas></div></div>
        <div class="card p-4"><h3 class="mb-1 font-bold">OP-13 ราคาวิ่ง (pump & fade, USD)</h3><p class="mb-3 text-xs text-slate-500">$157 → พีค ~$700 → ย่อ $470 ภายในไม่กี่เดือน</p><div class="h-72"><canvas id="chart-op13run"></canvas></div></div>
      </div>
    </section>

    <!-- ============ GRADE & CARDS ============ -->
    <section id="grade" class="scroll-mt-28 pt-10">
      <h2 class="mb-4 text-xl font-bold">🏆 เกรด & การ์ดเดี่ยว</h2>
      <div class="grid gap-5 lg:grid-cols-2">
        <div class="card p-4"><h3 class="mb-1 font-bold">การ์ด Manga Rare: RAW vs GRADED (บาท)</h3><p class="mb-3 text-xs text-slate-500">⚠️ ราคาชุมชน card2price · มาตราส่วน log</p><div class="h-72"><canvas id="chart-singles"></canvas></div></div>
        <div class="card p-4"><h3 class="mb-1 font-bold">Pull Rate ต่อ rarity (1 ใน N ซอง)</h3><p class="mb-3 text-xs text-slate-500">⚠️ ตัวเลขชุมชน · MR หายากสุด ~1 ใน 500–1,500 ซอง</p><div class="h-72"><canvas id="chart-pull"></canvas></div></div>
        <div class="card p-4"><h3 class="mb-1 font-bold">ค่าเกรด PSA vs CGC (USD/ใบ)</h3><p class="mb-3 text-xs text-slate-500">CGC ถูกกว่า · PSA10 ขายแพงกว่า CGC ~18–29% (modern)</p><div class="h-72"><canvas id="chart-grading"></canvas></div></div>
        <div class="card p-4"><h3 class="mb-1 font-bold">ส่งเกรดผ่าน CardKub (บาท/ใบ รวมส่งไป-กลับ)</h3><p class="mb-3 text-xs text-slate-500">ตัวแทนไทย จ่ายเป็นบาท · group submission แชร์ค่าส่งได้</p><div class="h-64"><canvas id="chart-cardkub"></canvas></div></div>
      </div>
      <!-- chase cards -->
      <div class="card mt-5 p-4">
        <h3 class="mb-2 font-bold">การ์ด chase ที่ยืนยันราคาได้ ✅</h3>
        <div class="table-wrap"><table class="w-full text-sm">
          <thead><tr class="text-left text-slate-500"><th class="p-2">การ์ด</th><th class="p-2">ราคา</th><th class="p-2">หมายเหตุ</th></tr></thead>
          <tbody>{M.CHASE.map((c) => (<tr class="border-t border-[var(--border)]"><td class="p-2 font-medium">{c.card}</td><td class="p-2 font-bold">{c.price}</td><td class="p-2 text-slate-500">{c.conf} {c.note}</td></tr>))}</tbody>
        </table></div>
      </div>
    </section>

    <!-- ============ COST ============ -->
    <section id="cost" class="scroll-mt-28 pt-10">
      <h2 class="mb-4 text-xl font-bold">🚚 ต้นทุน & โลจิสติกส์</h2>
      <div class="grid gap-5 lg:grid-cols-2">
        <div class="card p-4"><h3 class="mb-1 font-bold">ค่าส่ง DHL ตามน้ำหนัก (บาท)</h3><p class="mb-3 text-xs text-slate-500">list 2025 ยังไม่รวม fuel + VAT · US ≈ 2.5× HK</p><div class="h-64"><canvas id="chart-dhl"></canvas></div></div>
        <div class="card p-4"><h3 class="mb-1 font-bold">ค่าธรรมเนียมแพลตฟอร์มขาย (% all-in)</h3><p class="mb-3 text-xs text-slate-500">TikTok ถูกสุดในประเทศ · eBay แพงสุดฝั่งส่งออก</p><div class="h-72"><canvas id="chart-fees"></canvas></div></div>
      </div>
      <div class="card mt-5 p-4">
        <h3 class="mb-1 font-bold">นำเข้ามาขายในไทย — มาร์จิ้นแต่ละเส้นทาง (OP-16)</h3>
        <p class="mb-3 text-xs text-slate-500">⚠️ อากรประเมิน 10–20% (ยังไม่ยืนยัน) · เกือบทุกเส้นทางขาดทุน เว้น MSRP ยกเคส หรือ EN เชิงพาณิชย์</p>
        <div class="h-72"><canvas id="chart-landed"></canvas></div>
      </div>
    </section>

    <!-- ============ STRATEGY ============ -->
    <section id="strategy" class="scroll-mt-28 pt-10">
      <h2 class="mb-4 text-xl font-bold">🎯 กลยุทธ์ & การจัดพอร์ต</h2>

      <!-- 3 strategies table -->
      <div class="card p-4">
        <h3 class="mb-2 font-bold">เทียบ 3 กลยุทธ์หลัก</h3>
        <div class="table-wrap"><table class="w-full text-sm">
          <thead><tr class="text-left text-slate-500"><th class="p-2">กลยุทธ์</th><th class="p-2">กำไร</th><th class="p-2">ความเสี่ยง</th><th class="p-2">มือใหม่</th><th class="p-2">กฎสำคัญ</th></tr></thead>
          <tbody>{M.STRATEGIES.map((s) => (<tr class="border-t border-[var(--border)]"><td class="p-2 font-medium">{s.emoji} {s.name}</td><td class="p-2">{s.profit}</td><td class="p-2">{s.risk}</td><td class="p-2">{s.beginner}</td><td class="p-2 text-slate-500">{s.rule}<div class="text-xs text-slate-400">{s.evidence}</div></td></tr>))}</tbody>
        </table></div>
      </div>

      <div class="mt-5 grid gap-5 lg:grid-cols-2">
        <div class="card p-4"><h3 class="mb-1 font-bold">ผลตอบแทนตามแนวเก็งกำไร (%)</h3><p class="mb-3 text-xs text-slate-500">{M.LONG_HOLD.label}: {M.LONG_HOLD.note}</p><div class="h-56"><canvas id="chart-spec"></canvas></div></div>
        <div class="card p-4"><h3 class="mb-1 font-bold">จัดพอร์ต 3 ถัง (แนวทาง)</h3><p class="mb-3 text-xs text-slate-500">ห้าม all-in · สูงสุด 30% ต่อชุด/สินทรัพย์เดียว</p><div class="h-56"><canvas id="chart-buckets"></canvas></div></div>
      </div>

      <!-- budget tiers -->
      <h3 class="mt-8 mb-3 font-bold">แผนตามงบประมาณ</h3>
      <div class="grid gap-3 lg:grid-cols-3">
        {M.BUDGET.map((b) => (
          <div class="card p-4">
            <div class="flex items-baseline justify-between"><div class="font-bold">{b.emoji} {b.tier}</div><div class="text-xs text-slate-500">{b.goal}</div></div>
            <ul class="mt-2 list-disc space-y-1 pl-4 text-sm text-slate-600">{b.todo.map((t) => <li>{t}</li>)}</ul>
            <div class="mt-2 text-xs text-red-600">❌ เลี่ยง: {b.avoid}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- ============ INVEST ============ -->
    <section id="invest" class="scroll-mt-28 pt-10">
      <h2 class="mb-4 text-xl font-bold">📊 เทียบกับการลงทุนอื่น</h2>
      <div class="card p-4">
        <div class="table-wrap"><table class="w-full text-sm">
          <thead><tr class="text-left text-slate-500"><th class="p-2"></th><th class="p-2">🃏 TCG</th><th class="p-2">📈 หุ้น</th><th class="p-2">🥇 ทอง</th><th class="p-2">₿ คริปโต</th></tr></thead>
          <tbody>{M.INVEST.map((r) => (<tr class="border-t border-[var(--border)]"><td class="p-2 font-medium">{r.dim}</td><td class="p-2">{r.tcg}</td><td class="p-2">{r.stock}</td><td class="p-2">{r.gold}</td><td class="p-2">{r.crypto}</td></tr>))}</tbody>
        </table></div>
        <div class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
          <div class="rounded-lg bg-green-50 p-3"><span class="font-bold text-green-700">🐂 บูม:</span> {M.INVEST_RETURNS.boom}</div>
          <div class="rounded-lg bg-red-50 p-3"><span class="font-bold text-red-700">🐻 ปรับฐาน:</span> {M.INVEST_RETURNS.bust}</div>
        </div>
        <p class="mt-3 text-sm font-semibold text-slate-700">💡 {M.INVEST_RETURNS.rule}</p>
        <p class="mt-1 text-xs text-slate-400">⚠️ อิงข้อมูล Pokémon/MTG — ไม่มีตัวเลขเฉพาะ OP TCG</p>
      </div>

      <!-- MR cost vs single -->
      <div class="card mt-5 p-4">
        <h3 class="mb-2 font-bold">เปิดซองหา Manga Rare เอง vs ซื้อ single ตรงๆ</h3>
        <div class="flex flex-wrap items-end gap-6">
          <div><div class="text-xs text-slate-500">ค่าเปิดซองคาดหวังได้ MR 1 ใบ</div><div class="text-2xl font-extrabold signal-red">฿{fmt(M.MR_COST.openToPull[0])}–{fmt(M.MR_COST.openToPull[1])}</div></div>
          <div class="text-2xl text-slate-300">vs</div>
          <div><div class="text-xs text-slate-500">ซื้อ single (Manga Shanks ~$500)</div><div class="text-2xl font-extrabold signal-green">~฿{fmt(M.MR_COST.buySingle)}</div></div>
        </div>
        <p class="mt-2 text-sm text-slate-500">🔑 อยากได้การ์ดใบไหน → ซื้อ single. การเปิดซอง = จ่ายเพื่อความสนุก/เสี่ยงโชค ไม่ใช่การลงทุน</p>
      </div>
    </section>

    <!-- ============ FORECAST ============ -->
    <section id="forecast" class="scroll-mt-28 pt-10">
      <h2 class="mb-4 text-xl font-bold">🔮 พยากรณ์ & ไทม์ไลน์</h2>
      <div class="grid gap-5 lg:grid-cols-2">
        <div class="card p-4"><h3 class="mb-1 font-bold">ช่วงคาดการณ์ราคา 2026 (%)</h3><p class="mb-3 text-xs text-slate-500">⚠️ ฉากทัศน์ Base — ตัวเลขเป็นช่วงประเมิน</p><div class="h-56"><canvas id="chart-forecast"></canvas></div></div>
        <div class="card p-4">
          <h3 class="mb-2 font-bold">ไทม์ไลน์ชุดหลัก (EN)</h3>
          <div class="flex gap-3 overflow-x-auto pb-2">
            {M.TIMELINE.map((t) => (<div class="min-w-[120px] shrink-0 border-l-2 border-[var(--accent)] pl-2"><div class="text-sm font-bold">{t.code}</div><div class="text-xs text-slate-600">{t.name}</div><div class="mt-1 text-xs text-slate-400">{t.date}</div></div>))}
          </div>
        </div>
      </div>
    </section>

    <!-- Sources -->
    <section class="mt-10 border-t border-[var(--border)] pt-5 text-sm text-slate-500">
      <span class="font-semibold text-slate-700">ที่มาข้อมูล (โน้ตในคลัง):</span>
      {M.sourceNotes.map((t, i) => (<>{i > 0 && ' · '}<a href={noteLink(t.slice(0, 12))} class="text-[var(--accent)] hover:underline">{t}</a></>))}
      <p class="mt-2 text-xs text-slate-400">ทุกตัวเลขเป็น snapshot ปี 2025–2026 · เครื่องหมาย ⚠️/❌ = ข้อมูลยังไม่ยืนยัน/ถูก refute ตามต้นฉบับ · เช็คล่าสุดก่อนตัดสินใจเสมอ</p>
    </section>
  </main>

  <script id="dash-data" type="application/json" is:inline set:html={chartsJson}></script>
  <script>
    import Chart from 'chart.js/auto';
    const el = document.getElementById('dash-data');
    if (el) {
      const configs = JSON.parse(el.textContent || '{}');
      for (const [id, config] of Object.entries(configs)) {
        const canvas = document.getElementById('chart-' + id);
        if (canvas) new Chart(canvas as HTMLCanvasElement, config as any);
      }
    }
  </script>
</Base>
