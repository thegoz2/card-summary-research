---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { rawName, noteSlug } from '../lib/notes';
import { parseLogTable } from '../lib/tracking';
import {
  META,
  BOX_MARKETS,
  BOX_PRICES,
  TCGKING,
  SINGLES,
  BUBBLE,
  TIMELINE,
} from '../data/market';

const all = await getCollection('notes');
const trackingNote = all.find((n) => rawName(n).includes('Tracking Sheet'));
const series = trackingNote ? parseLogTable(trackingNote.body ?? '') : [];

const noteLink = (titlePart: string) => {
  const n = all.find((x) => rawName(x).includes(titlePart));
  return n ? `/notes/${noteSlug(n)}/` : '/notes/';
};

const baht = (n: number) => n.toLocaleString('en-US');
const redCount = BUBBLE.filter((b) => b.status === 'red').length;
const yellowCount = BUBBLE.filter((b) => b.status === 'yellow').length;
const greenCount = BUBBLE.filter((b) => b.status === 'green').length;

// KPI cards
const op13 = BOX_PRICES.find((b) => b.set === 'OP-13')!;
const usSasomRatio = op13.usSec && op13.sasom ? (op13.usSec / op13.sasom).toFixed(1) : '—';
const sealed = TCGKING.find((t) => t.key === 'Sealed Box')!.value;
const tr = TCGKING.find((t) => t.key === 'Treasure Rare')!.value;

const dot = (s: string) =>
  s === 'green' ? '🟢' : s === 'yellow' ? '🟡' : '🔴';

// ---- Chart.js configs (serialized to the client) ----
const tcgkingColors = TCGKING.map((d) => (d.value >= 100 ? '#16a34a' : '#dc2626'));
const charts: Record<string, unknown> = {
  tcgking: {
    type: 'bar',
    data: {
      labels: TCGKING.map((d) => d.key),
      datasets: [
        { type: 'line', label: 'เส้นฐาน 100', data: TCGKING.map(() => 100), borderColor: '#94a3b8', borderDash: [6, 4], pointRadius: 0, borderWidth: 1.5 },
        { type: 'bar', label: 'ดัชนี', data: TCGKING.map((d) => d.value), backgroundColor: tcgkingColors, borderRadius: 6 },
      ],
    },
    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { suggestedMin: 60 } } },
  },
  box: {
    type: 'bar',
    data: {
      labels: BOX_PRICES.map((b) => `${b.set}`),
      datasets: BOX_MARKETS.map((m) => ({
        label: m.label,
        data: BOX_PRICES.map((b) => (b as Record<string, number | null>)[m.key]),
        backgroundColor: m.color,
        borderRadius: 5,
      })),
    },
    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } }, scales: { y: { title: { display: true, text: 'บาท' } } } },
  },
  singles: {
    type: 'bar',
    data: {
      labels: SINGLES.map((s) => s.card),
      datasets: [
        { label: 'RAW', data: SINGLES.map((s) => s.raw), backgroundColor: '#94a3b8', borderRadius: 5 },
        { label: 'GRADED', data: SINGLES.map((s) => s.graded), backgroundColor: '#f59e0b', borderRadius: 5 },
      ],
    },
    options: { responsive: true, maintainAspectRatio: false, indexAxis: 'y', plugins: { legend: { position: 'bottom' } }, scales: { x: { type: 'logarithmic', title: { display: true, text: 'บาท (log scale)' } } } },
  },
};
if (series.length > 0) {
  charts.series = {
    type: 'line',
    data: {
      labels: series.map((r) => r.month),
      datasets: [
        { label: 'Sealed Box', data: series.map((r) => r.sealed), borderColor: '#3b82f6', backgroundColor: '#3b82f6', tension: 0.3, spanGaps: true },
        { label: 'Leader Alt-Art', data: series.map((r) => r.leader), borderColor: '#16a34a', backgroundColor: '#16a34a', tension: 0.3, spanGaps: true },
        { label: 'Treasure Rare', data: series.map((r) => r.tr), borderColor: '#dc2626', backgroundColor: '#dc2626', tension: 0.3, spanGaps: true },
      ],
    },
    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } }, scales: { y: { suggestedMin: 60 } } },
  };
}
const chartsJson = JSON.stringify(charts).replaceAll('<', '\\u003c');
---

<Base title="Dashboard">
  <main class="mx-auto max-w-6xl px-4 py-6">
    <div class="flex flex-wrap items-end justify-between gap-2">
      <div>
        <h1 class="text-2xl font-extrabold sm:text-3xl">📊 Dashboard วิเคราะห์ตลาด OP TCG</h1>
        <p class="mt-1 text-sm text-slate-500">ข้อมูล ณ {META.asOf} · {META.rates}</p>
      </div>
      <a href={noteLink('Tracking Sheet')} class="text-sm text-[var(--accent)] hover:underline">
        เปิด Tracking Sheet →
      </a>
    </div>

    <!-- KPI cards -->
    <section class="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-4">
      <div class="card p-4">
        <div class="text-xs text-slate-500">TCGKing Sealed</div>
        <div class="mt-1 text-2xl font-extrabold signal-green">{sealed}</div>
        <div class="text-xs text-slate-400">ยืนเหนือ 100 = แข็งแรง</div>
      </div>
      <div class="card p-4">
        <div class="text-xs text-slate-500">TCGKing Treasure Rare</div>
        <div class="mt-1 text-2xl font-extrabold signal-red">{tr}</div>
        <div class="text-xs text-slate-400">หลุด 100 = ปรับฐาน</div>
      </div>
      <div class="card p-4">
        <div class="text-xs text-slate-500">OP-16 SASOM (P2P)</div>
        <div class="mt-1 text-2xl font-extrabold">{baht(BOX_PRICES.find((b) => b.set === 'OP-16')!.sasom!)} ฿</div>
        <div class="text-xs text-slate-400">ชุดล่าสุด</div>
      </div>
      <div class="card p-4">
        <div class="text-xs text-slate-500">OP-13 US vs SASOM</div>
        <div class="mt-1 text-2xl font-extrabold">{usSasomRatio}×</div>
        <div class="text-xs text-slate-400">ช่องว่างราคาข้ามตลาด</div>
      </div>
    </section>

    <!-- Bubble dashboard -->
    <section class="mt-8">
      <h2 class="mb-3 text-lg font-bold">🚦 สัญญาณเตือนฟองสบู่ (8 ตัวชี้วัด)</h2>
      <div class="card mb-4 flex flex-wrap items-center gap-x-6 gap-y-2 p-4">
        <div class="text-sm">
          <span class="signal-green font-bold">🟢 {greenCount}</span> ·
          <span class="signal-yellow font-bold">🟡 {yellowCount}</span> ·
          <span class="signal-red font-bold">🔴 {redCount}</span>
        </div>
        <div class="text-sm font-semibold text-amber-700">
          อ่านสัญญาณ: 🟡 Base เริ่มเอียง bearish — ดัชนีรอง SP/TR หลุด 100 (late-cycle)
        </div>
        <a href={noteLink('ฟองสบู่')} class="ml-auto text-sm text-[var(--accent)] hover:underline">บทวิเคราะห์เต็ม →</a>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {BUBBLE.map((b) => (
          <div class="card p-3">
            <div class="flex items-start gap-2">
              <span class="text-lg leading-none">{dot(b.status)}</span>
              <div>
                <div class="text-sm font-semibold leading-snug">{b.name}</div>
                <div class="mt-1 text-xs text-slate-500">{b.detail}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Charts grid -->
    <section class="mt-8 grid gap-5 lg:grid-cols-2">
      <div class="card p-4">
        <h2 class="mb-1 font-bold">ดัชนี TCGKing (พ.ค. 2026)</h2>
        <p class="mb-3 text-xs text-slate-500">เทียบกับเส้นฐาน 100 — เขียว = เหนือฐาน, แดง = หลุดฐาน</p>
        <div class="h-72"><canvas id="chart-tcgking"></canvas></div>
      </div>

      <div class="card p-4">
        <h2 class="mb-1 font-bold">ราคา Booster Box เทียบตลาด (บาท)</h2>
        <p class="mb-3 text-xs text-slate-500">SASOM ไทย vs JP ตลาดรอง vs US secondary</p>
        <div class="h-72"><canvas id="chart-box"></canvas></div>
      </div>

      <div class="card p-4">
        <h2 class="mb-1 font-bold">การ์ดเดี่ยว Manga Rare: RAW vs GRADED (บาท)</h2>
        <p class="mb-3 text-xs text-slate-500">ราคาชุมชน card2price · มาตราส่วน log</p>
        <div class="h-72"><canvas id="chart-singles"></canvas></div>
      </div>

      <div class="card p-4">
        <h2 class="mb-1 font-bold">แนวโน้มดัชนีรายเดือน</h2>
        <p class="mb-3 text-xs text-slate-500">
          {series.length > 1
            ? 'จากตาราง Log ใน Tracking Sheet'
            : 'มีข้อมูลเริ่มต้น 1 จุด — กรอกเดือนถัดไปใน Obsidian แล้วเส้นจะต่อเอง'}
        </p>
        <div class="h-72"><canvas id="chart-series"></canvas></div>
      </div>
    </section>

    <!-- Timeline -->
    <section class="mt-8">
      <h2 class="mb-3 text-lg font-bold">🗓️ ไทม์ไลน์ชุดหลัก (EN)</h2>
      <div class="card flex gap-3 overflow-x-auto p-4">
        {TIMELINE.map((t) => (
          <div class="min-w-[130px] shrink-0 border-l-2 border-[var(--accent)] pl-3">
            <div class="text-sm font-bold">{t.code}</div>
            <div class="text-xs text-slate-600">{t.name}</div>
            <div class="mt-1 text-xs text-slate-400">{t.date}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Sources -->
    <section class="mt-8 text-sm text-slate-500">
      <span class="font-semibold text-slate-700">ที่มาข้อมูล:</span>
      {META.sourceNotes.map((t, i) => (
        <>
          {i > 0 && ' · '}
          <a href={noteLink(t.slice(0, 12))} class="text-[var(--accent)] hover:underline">{t}</a>
        </>
      ))}
    </section>
  </main>

  <script id="dash-data" type="application/json" is:inline set:html={chartsJson}></script>
  <script>
    import Chart from 'chart.js/auto';
    const el = document.getElementById('dash-data');
    if (el) {
      const configs = JSON.parse(el.textContent || '{}');
      for (const [id, config] of Object.entries(configs)) {
        const canvas = document.getElementById('chart-' + id);
        if (canvas) new Chart(canvas as HTMLCanvasElement, config as any);
      }
    }
  </script>
</Base>
